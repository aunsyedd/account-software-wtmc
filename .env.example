# Same Supabase project as papas-inventory-software. WTMC's tables all end in
# "_wtmc" (supabase/setup_wtmc.sql), so the data stays separate.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
NEXT_PUBLIC_APP_NAME=WTMC Inventory Software
# Optional: secret used to sign login cookies (falls back to SUPABASE_SECRET_KEY)
SESSION_SECRET=
# Nexora Invoices sync (nexora-invoices-wtmc). From the INVOICE app's Supabase project:
# Project Settings → API → Project URL and a secret / service_role key. Server-only.
NEXORA_SUPABASE_URL=https://YOUR_NEXORA_PROJECT.supabase.co
# Use the anon key (the WTMC invoice project lets it read customers/invoices),
# or a secret / service_role key.
NEXORA_SUPABASE_ANON_KEY=REPLACE_ME
NEXORA_SUPABASE_SECRET_KEY=
